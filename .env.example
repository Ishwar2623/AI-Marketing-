# Netlify environment variables
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only secrets. NEVER put these in frontend JS.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional Meta server credentials
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://YOUR-SITE.netlify.app/api/meta/callback
META_API_VERSION=v24.0
META_LIVE_ENABLED=false
